import cv2
from Alan import ReconocedorEstatico


def main():
    # Instanciamos el reconocedor unificado alojado en Alan.py
    reconocedor = ReconocedorEstatico()

    # Iniciar la cámara
    camara = cv2.VideoCapture(0)

    if not camara.isOpened():
        print("Error: No se pudo acceder a la cámara")
        return

    print("=== RECONOCEDOR DE SEÑAS INICIADO ===")
    print("Muestra tu mano frente a la cámara.")
    print("Presiona la tecla ESC para salir.")

    while True:
        correcto, frame = camara.read()

        if not correcto:
            print("No se pudo recibir imagen de la cámara")
            break

        # Espejear la imagen para mayor comodidad gráfica
        frame = cv2.flip(frame, 1)

        # Procesar la seña utilizando el método de Alan
        frame = reconocedor.reconocer(frame)

        # Mostrar el resultado
        cv2.imshow("Traductor de Señas LSA - Módulo Facu", frame)

        # Salir con ESC
        tecla = cv2.waitKey(1)
        if tecla == 27:
            break

    # Liberar la cámara al finalizar
    camara.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()

