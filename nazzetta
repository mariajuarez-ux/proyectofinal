import cv2
import mediapipe as mp

# Inicializar MediaPipe
mp_manos = mp.solutions.hands
mp_dibujo = mp.solutions.drawing_utils

manos = mp_manos.Hands(
    max_num_hands=2,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7
)

# Abrir cámara
camara = cv2.VideoCapture(0)

while True:
    ret, frame = camara.read()

    if not ret:
        break

    # Dar vuelta la imagen como espejo
    frame = cv2.flip(frame, 1)

    # Convertir de BGR a RGB
    imagen_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

    # Detectar manos
    resultado = manos.process(imagen_rgb)

    if resultado.multi_hand_landmarks:

        for mano in resultado.multi_hand_landmarks:

            # Dibujar los puntos de la mano
            mp_dibujo.draw_landmarks(
                frame,
                mano,
                mp_manos.HAND_CONNECTIONS
            )

            puntos = mano.landmark

            dedos = 0

            # Índice
            if puntos[8].y < puntos[6].y:
                dedos += 1

            # Medio
            if puntos[12].y < puntos[10].y:
                dedos += 1

            # Anular
            if puntos[16].y < puntos[14].y:
                dedos += 1

            # Meñique
            if puntos[20].y < puntos[18].y:
                dedos += 1

            # Pulgar
            if puntos[4].x < puntos[3].x:
                dedos += 1

            # Mostrar cantidad de dedos
            cv2.putText(
                frame,
                f"Dedos: {dedos}",
                (30, 70),
                cv2.FONT_HERSHEY_SIMPLEX,
                2,
                (0, 255, 0),
                3
            )

    # Mostrar cámara
    cv2.imshow("Detector de Dedos", frame)

    # Presionar Q para salir
    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

# Cerrar todo
camara.release()
cv2.destroyAllWindows()
